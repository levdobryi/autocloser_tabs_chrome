{
  "manifest_version": 3,
  "name": "Автозакрытие вкладок",
  "version": "1.0.0",
  "description": "Показывает вкладки, которые давно не открывали, и закрывает их одним нажатием. Только вручную, без автоудаления.",
  "permissions": ["tabs", "storage", "alarms"],
  "action": {
    "default_title": "Автозакрытие вкладок",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
